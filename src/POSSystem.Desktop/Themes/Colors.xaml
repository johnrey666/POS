<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================== -->
    <!--  BASE DARK COLORS                        -->
    <!-- ======================================== -->
    <Color x:Key="BackgroundDark">#0A0A0F</Color>
    <Color x:Key="BackgroundDarker">#060608</Color>
    <Color x:Key="SurfaceDark">#14141E</Color>
    <Color x:Key="SurfaceMedium">#1A1A2E</Color>
    <Color x:Key="SurfaceLight">#22223A</Color>
    <Color x:Key="SurfaceLighter">#2A2A44</Color>

    <!-- ======================================== -->
    <!--  GLASS / TRANSPARENT COLORS              -->
    <!-- ======================================== -->
    <Color x:Key="GlassColor">#20FFFFFF</Color>
    <Color x:Key="GlassBorderColor">#30FFFFFF</Color>
    <Color x:Key="GlassHighlightColor">#15FFFFFF</Color>

    <!-- ======================================== -->
    <!--  ACCENT GRADIENT COLORS                  -->
    <!-- ======================================== -->
    <Color x:Key="AccentStart">#6366F1</Color>      <!-- Indigo -->
    <Color x:Key="AccentMid">#8B5CF6</Color>        <!-- Violet -->
    <Color x:Key="AccentEnd">#D946EF</Color>        <!-- Fuchsia -->
    <Color x:Key="AccentGlow">#A855F7</Color>       <!-- Purple glow -->

    <!-- ======================================== -->
    <!--  SEMANTIC COLORS                         -->
    <!-- ======================================== -->
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="InfoColor">#60A5FA</Color>

    <!-- ======================================== -->
    <!--  TEXT COLORS                             -->
    <!-- ======================================== -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="TextTertiary">#64748B</Color>
    <Color x:Key="TextOnAccent">#FFFFFF</Color>

    <!-- ======================================== -->
    <!--  SHADOW / EFFECTS                        -->
    <!-- ======================================== -->
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- ======================================== -->
    <!--  BRUSHES                                 -->
    <!-- ======================================== -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundDark}"/>
    <SolidColorBrush x:Key="BackgroundDarkerBrush" Color="{StaticResource BackgroundDarker}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceDark}"/>
    <SolidColorBrush x:Key="SurfaceMediumBrush" Color="{StaticResource SurfaceMedium}"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}"/>
    <SolidColorBrush x:Key="SurfaceLighterBrush" Color="{StaticResource SurfaceLighter}"/>

    <!-- Glass -->
    <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassColor}"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}"/>
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="{StaticResource GlassHighlightColor}"/>

    <!-- Accent -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentStart}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentMid}" Offset="0.5"/>
        <GradientStop Color="{StaticResource AccentEnd}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentStart}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentEnd}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGlowBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentGlow}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentEnd}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccent}"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- Shadow -->
    <SolidColorBrush x:Key="ShadowColorBrush" Color="{StaticResource ShadowColor}"/>

    <!-- Sidebar -->
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource BackgroundDarker}" Offset="0"/>
        <GradientStop Color="{StaticResource BackgroundDark}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Logo Tile -->
    <LinearGradientBrush x:Key="LogoTileGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentStart}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentEnd}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Card Highlight -->
    <LinearGradientBrush x:Key="CardHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource SurfaceMedium}" Offset="0"/>
        <GradientStop Color="{StaticResource SurfaceDark}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Cart Header -->
    <LinearGradientBrush x:Key="CartHeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource SurfaceDark}" Offset="0"/>
        <GradientStop Color="{StaticResource SurfaceMedium}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Divider -->
    <SolidColorBrush x:Key="DividerBrush" Color="#2A2A44"/>

</ResourceDictionary>