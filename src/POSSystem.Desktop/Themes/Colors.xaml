<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Slate950Color">#020617</Color>
    <Color x:Key="Slate900Color">#0F172A</Color>
    <Color x:Key="Slate800Color">#1E293B</Color>
    <Color x:Key="Slate700Color">#334155</Color>
    <Color x:Key="Slate600Color">#475569</Color>
    <Color x:Key="Slate500Color">#64748B</Color>
    <Color x:Key="Slate400Color">#94A3B8</Color>
    <Color x:Key="Slate300Color">#CBD5E1</Color>
    <Color x:Key="Slate200Color">#E2E8F0</Color>
    <Color x:Key="Slate100Color">#F1F5F9</Color>
    <Color x:Key="Slate50Color">#F8FAFC</Color>

    <Color x:Key="Gold200Color">#FCE9C3</Color>
    <Color x:Key="Gold400Color">#E8C47A</Color>
    <Color x:Key="Gold500Color">#D4AF37</Color>
    <Color x:Key="Gold600Color">#B8960E</Color>

    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>

    <Color x:Key="ShadowColor">#0B1220</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Slate50Color}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Slate100Color}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource Slate950Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Slate200Color}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Gold500Color}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource Gold600Color}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource Gold400Color}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FBF3E3"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Slate900Color}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Slate500Color}"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource Slate100Color}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Slate200Color}"/>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Slate950Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Slate900Color}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Gold200Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Gold400Color}" Offset="0.5"/>
        <GradientStop Color="{StaticResource Gold500Color}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FDF3C7" Offset="0"/>
        <GradientStop Color="{StaticResource Gold200Color}" Offset="0.5"/>
        <GradientStop Color="{StaticResource Gold400Color}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Slate50Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Slate100Color}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Slate50Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Slate100Color}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoTileGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Slate100Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Gold200Color}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CartHeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Slate950Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Slate800Color}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
