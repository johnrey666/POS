<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!--  CORE PALETTE — Deep Navy + Warm Gold "premium retail" theme  -->
    <!-- ============================================================ -->

    <Color x:Key="NavyDarkestColor">#0A0F1C</Color>
    <Color x:Key="NavyDarkColor">#101A2E</Color>
    <Color x:Key="NavyMidColor">#16213A</Color>
    <Color x:Key="NavyLightColor">#212F4A</Color>

    <Color x:Key="GoldLightColor">#EACD8E</Color>
    <Color x:Key="GoldMidColor">#D4AF6A</Color>
    <Color x:Key="GoldDarkColor">#B3843A</Color>

    <Color x:Key="Slate900Color">#0F172A</Color>
    <Color x:Key="Slate700Color">#334155</Color>
    <Color x:Key="Slate500Color">#64748B</Color>
    <Color x:Key="Slate300Color">#CBD5E1</Color>
    <Color x:Key="Slate100Color">#F1F5F9</Color>

    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>

    <Color x:Key="ShadowColor">#0B1220</Color>

    <!-- ============================================================ -->
    <!--  SOLID BRUSHES                                                -->
    <!-- ============================================================ -->

    <SolidColorBrush x:Key="BackgroundBrush" Color="#EEF2F8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource NavyDarkestColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E9F2"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource GoldMidColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource GoldDarkColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource GoldLightColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FBF3E3"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Slate900Color}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Slate500Color}"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <SolidColorBrush x:Key="DividerBrush" Color="#EDF1F7"/>

    <!-- ============================================================ -->
    <!--  GRADIENT BRUSHES                                             -->
    <!-- ============================================================ -->

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource NavyDarkestColor}" Offset="0"/>
        <GradientStop Color="{StaticResource NavyDarkColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GoldLightColor}" Offset="0"/>
        <GradientStop Color="{StaticResource GoldMidColor}" Offset="0.55"/>
        <GradientStop Color="{StaticResource GoldDarkColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2D9A4" Offset="0"/>
        <GradientStop Color="{StaticResource GoldLightColor}" Offset="0.55"/>
        <GradientStop Color="{StaticResource GoldMidColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EEF2F8" Offset="0"/>
        <GradientStop Color="#E3EBF7" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F9FBFD" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoTileGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F3F0E7" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CartHeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource NavyDarkestColor}" Offset="0"/>
        <GradientStop Color="{StaticResource NavyLightColor}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
