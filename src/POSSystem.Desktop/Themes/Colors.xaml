<!--Colors.xaml-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Primary50">#EEF2FF</Color>
    <Color x:Key="Primary100">#E0E7FF</Color>
    <Color x:Key="Primary200">#C7D2FE</Color>
    <Color x:Key="Primary300">#A5B4FC</Color>
    <Color x:Key="Primary400">#818CF8</Color>
    <Color x:Key="Primary500">#6366F1</Color>
    <Color x:Key="Primary600">#4F46E5</Color>
    <Color x:Key="Primary700">#4338CA</Color>

    <Color x:Key="Gray50">#F8FAFC</Color>
    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray700">#334155</Color>
    <Color x:Key="Gray800">#1E293B</Color>
    <Color x:Key="Gray900">#0F172A</Color>

    <Color x:Key="Success500">#10B981</Color>
    <Color x:Key="Success50">#D1FAE5</Color>
    <Color x:Key="Warning500">#F59E0B</Color>
    <Color x:Key="Warning50">#FEF3C7</Color>
    <Color x:Key="Danger500">#EF4444</Color>
    <Color x:Key="Danger50">#FEE2E2</Color>
    <Color x:Key="Info500">#3B82F6</Color>
    <Color x:Key="Info50">#DBEAFE</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary500}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource Primary600}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource Primary50}"/>
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{StaticResource Primary200}"/>

    <SolidColorBrush x:Key="Gray50Brush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="White"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success500}"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource Success50}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning500}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource Warning50}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger500}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource Danger50}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info500}"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource Info50}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="White"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource Gray100}"/>

    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="SidebarTextActiveBrush" Color="White"/>

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Primary500}" Offset="0"/>
        <GradientStop Color="{StaticResource Primary700}" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="ShadowSmall" BlurRadius="8" ShadowDepth="2" Opacity="0.06" Color="#000"/>
    <DropShadowEffect x:Key="ShadowMedium" BlurRadius="12" ShadowDepth="4" Opacity="0.08" Color="#000"/>
    <DropShadowEffect x:Key="ShadowLarge" BlurRadius="20" ShadowDepth="8" Opacity="0.12" Color="#000"/>

</ResourceDictionary>
