<!--Dark.xaml-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Mode colors -->
    <Color x:Key="BackgroundLight">#1C1C1E</Color>
    <Color x:Key="BackgroundWhite">#2C2C2E</Color>
    <Color x:Key="SurfacePrimary">#2C2C2E</Color>
    <Color x:Key="SurfaceSecondary">#3A3A3C</Color>
    <Color x:Key="SurfaceTertiary">#3A3A3C</Color>
    <Color x:Key="SurfaceElevated">#3A3A3C</Color>

    <Color x:Key="BorderColor">#3A3A3C</Color>
    <Color x:Key="BorderSubtle">#3A3A3C</Color>
    <Color x:Key="DividerColor">#3A3A3C</Color>

    <Color x:Key="AccentStart">#0A84FF</Color>
    <Color x:Key="AccentMid">#5E5CE6</Color>
    <Color x:Key="AccentEnd">#AF52DE</Color>
    <Color x:Key="AccentGlow">#5E5CE6</Color>

    <Color x:Key="SuccessColor">#30D158</Color>
    <Color x:Key="ErrorColor">#FF453A</Color>
    <Color x:Key="WarningColor">#FF9F0A</Color>
    <Color x:Key="InfoColor">#0A84FF</Color>

    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#AEAEB2</Color>
    <Color x:Key="TextTertiary">#5C5C5E</Color>
    <Color x:Key="TextOnAccent">#FFFFFF</Color>

    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Brushes (same names as before) – just use the new colors -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundLight}"/>
    <SolidColorBrush x:Key="BackgroundWhiteBrush" Color="{StaticResource BackgroundWhite}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfacePrimary}"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondary}"/>
    <SolidColorBrush x:Key="SurfaceTertiaryBrush" Color="{StaticResource SurfaceTertiary}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevated}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentStart}"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentStart}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentMid}" Offset="0.55"/>
        <GradientStop Color="{StaticResource AccentEnd}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentStart}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentEnd}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGlowBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentGlow}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentEnd}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccent}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <SolidColorBrush x:Key="ShadowColorBrush" Color="{StaticResource ShadowColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="CartHeaderBrush" Color="#3A3A3C"/>
</ResourceDictionary>