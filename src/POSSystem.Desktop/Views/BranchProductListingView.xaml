<UserControl x:Class="POSSystem.Desktop.Views.BranchProductListingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Branch" VerticalAlignment="Center" FontWeight="SemiBold"
                           FontSize="14" Foreground="{DynamicResource Gray700Brush}"/>

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Branches}"
                          SelectedItem="{Binding SelectedBranch}"
                          DisplayMemberPath="Name"
                          Height="44"
                          Style="{StaticResource ModernComboBox}"
                          FontSize="14">
                    <ComboBox.Resources>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="{DynamicResource Gray900Brush}"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Gray50Brush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <Button Grid.Column="4"
                        Content="+ Add Product to Branch"
                        Height="40"
                        Padding="18,0"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddProductCommand}"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardLarge}" Padding="0">
                <DataGrid ItemsSource="{Binding BranchProductListings}"
                          Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                          RowStyle="{StaticResource ModernRow}"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Active"
                                                Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="260" IsReadOnly="True"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Master Price" Binding="{Binding MasterPrice, StringFormat=N2}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Branch Price" Binding="{Binding BranchPrice, StringFormat=N2}" Width="120">
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Gray900Brush}"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Save Prices"
                        Height="40"
                        Padding="18,0"
                        FontSize="13"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SavePriceCommand}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}"
                       Margin="0,12,0,0" FontSize="13"/>
            <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                       Margin="0,12,0,0" FontSize="13"/>
        </Grid>
    </ScrollViewer>
</UserControl>
