<UserControl x:Class="POSSystem.Desktop.Views.BranchProductListingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="+ Add Product to Branch"
                    Height="40"
                    Padding="18,0"
                    FontSize="13"
                    VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddProductCommand}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardLarge}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Gray50Brush}" 
                        Padding="20,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" 
                               Foreground="{DynamicResource Gray600Brush}"/>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding BranchProductListings}"
                          Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                          RowStyle="{StaticResource ModernRow}"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Active"
                                                Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="260" IsReadOnly="True"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Master Price" Binding="{Binding MasterPrice, StringFormat=N2}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Branch Price" Binding="{Binding BranchPrice, StringFormat=N2}" Width="120">
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Gray900Brush}"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
