<UserControl x:Class="POSSystem.Desktop.Views.BranchProductListingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="+ Add Product to Branch"
                    Height="32"
                    Padding="12,0"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddProductCommand}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardLarge}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Gray50Brush}" 
                        Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" 
                               Foreground="{DynamicResource Gray600Brush}"/>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding BranchProductListings}"
                          Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                          RowStyle="{StaticResource ModernRow}"
                          RowHeight="32"
                          ColumnHeaderHeight="32"
                          FontSize="12"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Active"
                                                Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="260" IsReadOnly="True"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Master Price" Binding="{Binding MasterPrice, StringFormat=N2}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Branch Price" Binding="{Binding BranchPrice, StringFormat=N2}" Width="120">
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Gray900Brush}"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Pagination -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button Content="◀ Prev"
                    Height="28"
                    Padding="10,0"
                    FontSize="11"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding PreviousPageCommand}"
                    Margin="0,0,8,0"/>
            <TextBlock Text="{Binding CurrentPage, StringFormat=Page {}{0}}"
                       VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"
                       Foreground="{DynamicResource Gray600Brush}"/>
            <TextBlock Text="of" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"
                       Foreground="{DynamicResource Gray600Brush}"/>
            <TextBlock Text="{Binding TotalPages, StringFormat={}{0}}"
                       VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                       Foreground="{DynamicResource Gray600Brush}"/>
            <TextBlock Text="{Binding TotalItems, StringFormat={}{0} items}"
                       VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                       Foreground="{DynamicResource Gray500Brush}"/>
            <Button Content="Next ▶"
                    Height="28"
                    Padding="10,0"
                    FontSize="11"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding NextPageCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
