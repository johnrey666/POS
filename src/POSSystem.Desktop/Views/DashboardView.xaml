<UserControl x:Class="POSSystem.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="YoYBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================== HEADER ===================== -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding Greeting, Mode=OneWay}"/>
                        <Run Text=", Admin"/>
                    </TextBlock>
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" Margin="0,2,0,0"/>
                    <TextBlock Text="Real-time performance overview across all branches"
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <!-- Live clock only (removed the buttons that caused the crash) -->
                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceTertiaryBrush}"
                        CornerRadius="8"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentDateTime}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>
            </Grid>

            <!-- ===================== KPI CARDS ===================== -->
            <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,20">

                <!-- 1. Today's Sales -->
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="&#xE9F1;" FontFamily="{StaticResource IconFont}"
                                       FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                            <Border HorizontalAlignment="Right" Background="#1A4CAF50"
                                    CornerRadius="4" Padding="6,2">
                                <TextBlock Text="↑ 12.4%" FontSize="11" FontWeight="SemiBold" Foreground="#4CAF50"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Today's Sales" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                        <TextBlock Text="₱12,450" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ProgressBar Value="68" Maximum="100" Height="4" Margin="0,10,0,0"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource SurfaceTertiaryBrush}"/>
                        <TextBlock Text="YTD ₱2.41M  •  68% of target" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2. Orders -->
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}"
                                       FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                            <Border HorizontalAlignment="Right" Background="#1A4CAF50"
                                    CornerRadius="4" Padding="6,2">
                                <TextBlock Text="↑ 8.1%" FontSize="11" FontWeight="SemiBold" Foreground="#4CAF50"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Orders Today" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                        <TextBlock Text="186" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Avg ₱67 per order" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3. Highest Branch -->
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="&#xE71E;" FontFamily="{StaticResource IconFont}"
                                   FontSize="18" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="Top Branch" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                        <TextBlock Text="Makati" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="₱8,200  •  66% of total" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 4. Peak Hour -->
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}"
                                   FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Peak Hour" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                        <TextBlock Text="2 – 4 PM" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="132 orders  •  ₱4.1k" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 5. Top Product -->
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}"
                                   FontSize="18" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="Top Product" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                        <TextBlock Text="Iced Americano" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="54 sold  •  ₱8,100" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 6. Active Terminals -->
                <Border Style="{StaticResource KpiCard}" Margin="0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="&#xE8AF;" FontFamily="{StaticResource IconFont}"
                                       FontSize="18" Foreground="{DynamicResource SuccessBrush}"/>
                            <Border HorizontalAlignment="Right" Background="#1A4CAF50"
                                    CornerRadius="4" Padding="6,2">
                                <TextBlock Text="Online" FontSize="11" FontWeight="SemiBold" Foreground="#4CAF50"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Active Terminals" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                        <TextBlock Text="14 / 16" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="2 offline  •  Check Quezon" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===================== MAIN CONTENT ===================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <StackPanel Grid.Column="0">

                    <!-- Top 10 Products Chart -->
                    <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Top 10 Products (YTD)" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="This Year vs Last Year comparison" Style="{StaticResource SectionSubtitle}"/>
                                </StackPanel>

                                <Border HorizontalAlignment="Right"
                                        Background="{DynamicResource SurfaceTertiaryBrush}"
                                        CornerRadius="6" Height="32" Width="150" VerticalAlignment="Center">
                                    <ComboBox Background="Transparent" BorderThickness="0"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              VerticalContentAlignment="Center" FontSize="12"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Filter by: Quantity"/>
                                        <ComboBoxItem Content="Filter by: Sales Value"/>
                                    </ComboBox>
                                </Border>
                            </Grid>

                            <!-- Legend -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="12" Height="12" Background="{DynamicResource AccentBrush}"
                                        CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="This Year" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <Border Width="12" Height="12" Background="{DynamicResource SurfaceTertiaryBrush}"
                                        CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Last Year" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Chart -->
                            <Grid Grid.Row="2" Height="200">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.ColumnSpan="10" BorderThickness="0,1,0,0"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        VerticalAlignment="Bottom" Margin="0,0,0,26" Opacity="0.5"/>

                                <!-- Product bars -->
                                <Grid Grid.Column="0" VerticalAlignment="Bottom" Margin="3,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="14" Height="75" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="3,3,0,0" Margin="0,0,3,0"/>
                                        <Border Width="14" Height="115" Background="{DynamicResource AccentBrush}" CornerRadius="3,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Espresso" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Grid>

                                <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="3,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="14" Height="65" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="3,3,0,0" Margin="0,0,3,0"/>
                                        <Border Width="14" Height="88" Background="{DynamicResource AccentBrush}" CornerRadius="3,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Latte" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Grid>

                                <Grid Grid.Column="2" VerticalAlignment="Bottom" Margin="3,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="14" Height="95" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="3,3,0,0" Margin="0,0,3,0"/>
                                        <Border Width="14" Height="145" Background="{DynamicResource AccentBrush}" CornerRadius="3,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Americano" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Grid>

                                <Grid Grid.Column="3" VerticalAlignment="Bottom" Margin="3,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="14" Height="70" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="3,3,0,0" Margin="0,0,3,0"/>
                                        <Border Width="14" Height="60" Background="{DynamicResource AccentBrush}" CornerRadius="3,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Cappuccino" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Grid>

                                <Grid Grid.Column="4" VerticalAlignment="Bottom" Margin="3,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="14" Height="55" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="3,3,0,0" Margin="0,0,3,0"/>
                                        <Border Width="14" Height="105" Background="{DynamicResource AccentBrush}" CornerRadius="3,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Mocha" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Grid>

                                <Grid Grid.Column="5" VerticalAlignment="Bottom" Margin="3,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="14" Height="50" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="3,3,0,0" Margin="0,0,3,0"/>
                                        <Border Width="14" Height="45" Background="{DynamicResource AccentBrush}" CornerRadius="3,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Tea" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Grid>

                                <Grid Grid.Column="6" VerticalAlignment="Bottom" Margin="3,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="14" Height="90" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="3,3,0,0" Margin="0,0,3,0"/>
                                        <Border Width="14" Height="135" Background="{DynamicResource AccentBrush}" CornerRadius="3,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Pastry" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Grid>

                                <Grid Grid.Column="7" VerticalAlignment="Bottom" Margin="3,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="14" Height="62" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="3,3,0,0" Margin="0,0,3,0"/>
                                        <Border Width="14" Height="80" Background="{DynamicResource AccentBrush}" CornerRadius="3,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Sandwich" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Grid>

                                <Grid Grid.Column="8" VerticalAlignment="Bottom" Margin="3,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="14" Height="36" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="3,3,0,0" Margin="0,0,3,0"/>
                                        <Border Width="14" Height="42" Background="{DynamicResource AccentBrush}" CornerRadius="3,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Juice" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Grid>

                                <Grid Grid.Column="9" VerticalAlignment="Bottom" Margin="3,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="14" Height="30" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="3,3,0,0" Margin="0,0,3,0"/>
                                        <Border Width="14" Height="26" Background="{DynamicResource AccentBrush}" CornerRadius="3,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Water" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Sales by Hour -->
                    <Border Style="{StaticResource CardBorder}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Sales by Hour (Today)" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Hourly performance distribution" Style="{StaticResource SectionSubtitle}" Margin="0,0,0,14"/>

                            <Grid Height="80">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Height="16" Background="{DynamicResource SurfaceTertiaryBrush}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Margin="2,0"/>
                                <Border Grid.Column="1" Height="25" Background="{DynamicResource SurfaceTertiaryBrush}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Margin="2,0"/>
                                <Border Grid.Column="2" Height="38" Background="{DynamicResource AccentBrush}" Opacity="0.7" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Margin="2,0"/>
                                <Border Grid.Column="3" Height="52" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Margin="2,0"/>
                                <Border Grid.Column="4" Height="65" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Margin="2,0"/>
                                <Border Grid.Column="5" Height="78" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Margin="2,0"/>
                                <Border Grid.Column="6" Height="62" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Margin="2,0"/>
                                <Border Grid.Column="7" Height="48" Background="{DynamicResource AccentBrush}" Opacity="0.85" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Margin="2,0"/>
                                <Border Grid.Column="8" Height="35" Background="{DynamicResource AccentBrush}" Opacity="0.6" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Margin="2,0"/>
                                <Border Grid.Column="9" Height="22" Background="{DynamicResource SurfaceTertiaryBrush}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Margin="2,0"/>
                                <Border Grid.Column="10" Height="16" Background="{DynamicResource SurfaceTertiaryBrush}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Margin="2,0"/>
                                <Border Grid.Column="11" Height="10" Background="{DynamicResource SurfaceTertiaryBrush}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Margin="2,0"/>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="8AM" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="12PM" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="8PM" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT SIDEBAR -->
                <StackPanel Grid.Column="2">

                    <!-- Top Products Ranked -->
                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Top Products Today" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="By quantity sold" Style="{StaticResource SectionSubtitle}" Margin="0,0,0,12"/>

                            <!-- Ranked items -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Width="22" Height="22">
                                    <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Iced Americano" FontWeight="SemiBold" FontSize="13"/>
                                    <ProgressBar Value="54" Maximum="60" Height="3" Margin="0,4,0,0"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource SurfaceTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="54" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="4" Width="22" Height="22">
                                    <TextBlock Text="2" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Espresso" FontWeight="SemiBold" FontSize="13"/>
                                    <ProgressBar Value="41" Maximum="60" Height="3" Margin="0,4,0,0"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource SurfaceTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="41" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="4" Width="22" Height="22">
                                    <TextBlock Text="3" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Croissant" FontWeight="SemiBold" FontSize="13"/>
                                    <ProgressBar Value="33" Maximum="60" Height="3" Margin="0,4,0,0"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource SurfaceTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="33" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="4" Width="22" Height="22">
                                    <TextBlock Text="4" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Latte" FontWeight="SemiBold" FontSize="13"/>
                                    <ProgressBar Value="29" Maximum="60" Height="3" Margin="0,4,0,0"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource SurfaceTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="29" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="4" Width="22" Height="22">
                                    <TextBlock Text="5" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Mocha" FontWeight="SemiBold" FontSize="13"/>
                                    <ProgressBar Value="24" Maximum="60" Height="3" Margin="0,4,0,0"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource SurfaceTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="24" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Alerts -->
                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Alerts" Style="{StaticResource SectionTitle}"/>
                                <Border HorizontalAlignment="Right" Background="#33FF5252"
                                        CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#FF5252"/>
                                </Border>
                            </Grid>

                            <Border Background="#1AFF5252" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                                               Foreground="#FF5252" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
