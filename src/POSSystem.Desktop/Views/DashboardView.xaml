<UserControl x:Class="POSSystem.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Multi-branch Point of Sale System"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                VerticalAlignment="Center"
                MaxWidth="560"
                HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="22"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border Background="{StaticResource BackgroundBrush}"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Your access"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Margin="0,8,0,0" FontSize="13"
                                   Text="{Binding DatabaseStatus, StringFormat=Database: {0}}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   HorizontalAlignment="Right"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="{Binding VersionDisplay, Mode=OneWay}"/>
    </Grid>
</UserControl>
