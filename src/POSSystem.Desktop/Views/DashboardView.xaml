<UserControl x:Class="POSSystem.Desktop.Views.DashboardView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- KPI CARDS -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,32">
                <!-- Today's Sales -->
                <Border Style="{StaticResource Card}" Margin="0,0,20,0">
                    <StackPanel>
                        <Border Width="48" Height="48" Background="{DynamicResource InfoBgBrush}" Margin="0,0,0,16">
                            <TextBlock Text="&#xE9F1;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource InfoBrush}"/>
                        </Border>
                        <TextBlock Text="Today's Sales" Style="{StaticResource BodySmall}" Margin="0,0,0,4"/>
                        <TextBlock Text="₱12,450" Style="{StaticResource Heading3}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="0" Padding="4,2">
                            <TextBlock Text="↑ 12.4%" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Orders -->
                <Border Style="{StaticResource Card}" Margin="0,0,20,0">
                    <StackPanel>
                        <Border Width="48" Height="48" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,0,16">
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        <TextBlock Text="Orders Today" Style="{StaticResource BodySmall}" Margin="0,0,0,4"/>
                        <TextBlock Text="186" Style="{StaticResource Heading3}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="0" Padding="4,2">
                            <TextBlock Text="↑ 8.1%" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Active Terminals -->
                <Border Style="{StaticResource Card}" Margin="0,0,20,0">
                    <StackPanel>
                        <Border Width="48" Height="48" Background="{DynamicResource SuccessBgBrush}" Margin="0,0,0,16">
                            <TextBlock Text="&#xE8AF;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                        <TextBlock Text="Active Terminals" Style="{StaticResource BodySmall}" Margin="0,0,0,4"/>
                        <TextBlock Text="14 / 16" Style="{StaticResource Heading3}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource WarningBgBrush}" CornerRadius="0" Padding="4,2">
                            <TextBlock Text="2 offline" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Avg Order -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Width="48" Height="48" Background="{DynamicResource WarningBgBrush}" Margin="0,0,0,16">
                            <TextBlock Text="&#xEC6F;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                        <TextBlock Text="Avg Order Value" Style="{StaticResource BodySmall}" Margin="0,0,0,4"/>
                        <TextBlock Text="₱67" Style="{StaticResource Heading3}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="0" Padding="4,2">
                            <TextBlock Text="↑ 3.2%" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- MAIN CONTENT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Charts -->
                <StackPanel Grid.Column="0">
                    <!-- Top Products -->
                    <Border Style="{StaticResource CardLarge}" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Top Products" Style="{StaticResource Heading3}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Best performing products this month" 
                                               Style="{StaticResource BodySmall}"/>
                                </StackPanel>

                                <ComboBox HorizontalAlignment="Right" Width="140" Height="36"
                                          Style="{StaticResource ModernComboBox}" FontSize="13">
                                    <ComboBoxItem Content="This Month" IsSelected="True"/>
                                    <ComboBoxItem Content="Last Month"/>
                                    <ComboBoxItem Content="This Year"/>
                                </ComboBox>
                            </Grid>

                            <!-- Legend -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="12" Height="12" Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="This Year" FontSize="12" Foreground="{DynamicResource Gray500Brush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Border Width="12" Height="12" Background="{DynamicResource Gray200Brush}"
                                        CornerRadius="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Last Year" FontSize="12" Foreground="{DynamicResource Gray500Brush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Chart -->
                            <Grid Grid.Row="2" Height="220">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.RowSpan="2" Grid.ColumnSpan="10" BorderThickness="0,1,0,0"
                                        BorderBrush="{DynamicResource Gray200Brush}"
                                        VerticalAlignment="Bottom" Margin="0,0,0,28" Opacity="0.5"/>

                                <!-- Bars -->
                                <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Bottom" Margin="4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="12" Height="80" Background="{DynamicResource Gray200Brush}" CornerRadius="0" Margin="0,0,2,0"/>
                                        <Border Width="12" Height="120" Background="{DynamicResource PrimaryBrush}" CornerRadius="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom" Margin="4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="12" Height="70" Background="{DynamicResource Gray200Brush}" CornerRadius="0" Margin="0,0,2,0"/>
                                        <Border Width="12" Height="95" Background="{DynamicResource PrimaryBrush}" CornerRadius="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" Margin="4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="12" Height="100" Background="{DynamicResource Gray200Brush}" CornerRadius="0" Margin="0,0,2,0"/>
                                        <Border Width="12" Height="150" Background="{DynamicResource PrimaryBrush}" CornerRadius="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="3" VerticalAlignment="Bottom" Margin="4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="12" Height="75" Background="{DynamicResource Gray200Brush}" CornerRadius="0" Margin="0,0,2,0"/>
                                        <Border Width="12" Height="65" Background="{DynamicResource PrimaryBrush}" CornerRadius="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="4" VerticalAlignment="Bottom" Margin="4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="12" Height="60" Background="{DynamicResource Gray200Brush}" CornerRadius="0" Margin="0,0,2,0"/>
                                        <Border Width="12" Height="110" Background="{DynamicResource PrimaryBrush}" CornerRadius="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="5" VerticalAlignment="Bottom" Margin="4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="12" Height="55" Background="{DynamicResource Gray200Brush}" CornerRadius="0" Margin="0,0,2,0"/>
                                        <Border Width="12" Height="48" Background="{DynamicResource PrimaryBrush}" CornerRadius="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="6" VerticalAlignment="Bottom" Margin="4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="12" Height="95" Background="{DynamicResource Gray200Brush}" CornerRadius="0" Margin="0,0,2,0"/>
                                        <Border Width="12" Height="140" Background="{DynamicResource PrimaryBrush}" CornerRadius="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="7" VerticalAlignment="Bottom" Margin="4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="12" Height="65" Background="{DynamicResource Gray200Brush}" CornerRadius="0" Margin="0,0,2,0"/>
                                        <Border Width="12" Height="85" Background="{DynamicResource PrimaryBrush}" CornerRadius="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="8" VerticalAlignment="Bottom" Margin="4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="12" Height="40" Background="{DynamicResource Gray200Brush}" CornerRadius="0" Margin="0,0,2,0"/>
                                        <Border Width="12" Height="45" Background="{DynamicResource PrimaryBrush}" CornerRadius="0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="9" VerticalAlignment="Bottom" Margin="4,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="12" Height="35" Background="{DynamicResource Gray200Brush}" CornerRadius="0" Margin="0,0,2,0"/>
                                        <Border Width="12" Height="30" Background="{DynamicResource PrimaryBrush}" CornerRadius="0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Labels -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Espresso" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Latte" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Americano" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Cappuccino" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="Mocha" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="5" Text="Tea" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="6" Text="Pastry" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="7" Text="Sandwich" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="8" Text="Juice" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="9" Text="Water" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Sales by Hour -->
                    <Border Style="{StaticResource CardLarge}">
                        <StackPanel>
                            <TextBlock Text="Sales by Hour" Style="{StaticResource Heading3}" Margin="0,0,0,4"/>
                            <TextBlock Text="Today's performance distribution" 
                                       Style="{StaticResource BodySmall}" Margin="0,0,0,20"/>

                            <Grid Height="100">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Height="20" Background="{DynamicResource Gray200Brush}" VerticalAlignment="Bottom" CornerRadius="0" Margin="2,0"/>
                                <Border Grid.Column="1" Height="28" Background="{DynamicResource Gray200Brush}" VerticalAlignment="Bottom" CornerRadius="0" Margin="2,0"/>
                                <Border Grid.Column="2" Height="42" Background="{DynamicResource Primary300Brush}" VerticalAlignment="Bottom" CornerRadius="0" Margin="2,0"/>
                                <Border Grid.Column="3" Height="58" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Bottom" CornerRadius="0" Margin="2,0"/>
                                <Border Grid.Column="4" Height="72" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Bottom" CornerRadius="0" Margin="2,0"/>
                                <Border Grid.Column="5" Height="85" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Bottom" CornerRadius="0" Margin="2,0"/>
                                <Border Grid.Column="6" Height="68" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Bottom" CornerRadius="0" Margin="2,0"/>
                                <Border Grid.Column="7" Height="52" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Bottom" CornerRadius="0" Margin="2,0"/>
                                <Border Grid.Column="8" Height="38" Background="{DynamicResource Primary300Brush}" VerticalAlignment="Bottom" CornerRadius="0" Margin="2,0"/>
                                <Border Grid.Column="9" Height="25" Background="{DynamicResource Gray200Brush}" VerticalAlignment="Bottom" CornerRadius="0" Margin="2,0"/>
                                <Border Grid.Column="10" Height="18" Background="{DynamicResource Gray200Brush}" VerticalAlignment="Bottom" CornerRadius="0" Margin="2,0"/>
                                <Border Grid.Column="11" Height="12" Background="{DynamicResource Gray200Brush}" VerticalAlignment="Bottom" CornerRadius="0" Margin="2,0"/>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="8AM" FontSize="11" Foreground="{DynamicResource Gray400Brush}"/>
                                <TextBlock Text="12PM" FontSize="11" Foreground="{DynamicResource Gray400Brush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="8PM" FontSize="11" Foreground="{DynamicResource Gray400Brush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT SIDEBAR -->
                <StackPanel Grid.Column="2">
                    <!-- Top Products -->
                    <Border Style="{StaticResource CardLarge}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Top Products Today" Style="{StaticResource Heading3}" Margin="0,0,0,4"/>
                            <TextBlock Text="By quantity sold" Style="{StaticResource BodySmall}" Margin="0,0,0,20"/>

                            <StackPanel Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="0" Width="24" Height="24">
                                        <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Iced Americano" FontWeight="SemiBold" FontSize="13"/>
                                        <Border Background="{DynamicResource Gray100Brush}" CornerRadius="0" Height="3" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="0" Width="54" Height="3"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="54" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource Gray200Brush}" CornerRadius="0" Width="24" Height="24">
                                        <TextBlock Text="2" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Gray600Brush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Espresso" FontWeight="SemiBold" FontSize="13"/>
                                        <Border Background="{DynamicResource Gray100Brush}" CornerRadius="0" Height="3" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="0" Width="41" Height="3"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="41" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource Gray200Brush}" CornerRadius="0" Width="24" Height="24">
                                        <TextBlock Text="3" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Gray600Brush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Croissant" FontWeight="SemiBold" FontSize="13"/>
                                        <Border Background="{DynamicResource Gray100Brush}" CornerRadius="0" Height="3" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="0" Width="33" Height="3"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="33" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource Gray200Brush}" CornerRadius="0" Width="24" Height="24">
                                        <TextBlock Text="4" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Gray600Brush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Latte" FontWeight="SemiBold" FontSize="13"/>
                                        <Border Background="{DynamicResource Gray100Brush}" CornerRadius="0" Height="3" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="0" Width="29" Height="3"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="29" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource Gray200Brush}" CornerRadius="0" Width="24" Height="24">
                                        <TextBlock Text="5" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Gray600Brush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Mocha" FontWeight="SemiBold" FontSize="13"/>
                                        <Border Background="{DynamicResource Gray100Brush}" CornerRadius="0" Height="3" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="0" Width="24" Height="3"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="24" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Alerts -->
                    <Border Style="{StaticResource CardLarge}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Alerts" Style="{StaticResource Heading3}"/>
                                <Border Background="{DynamicResource DangerBgBrush}" CornerRadius="0" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock Text="3" FontSize="11" FontWeight="Bold" 
                                               Foreground="{DynamicResource DangerBrush}"/>
                                </Border>
                            </Grid>

                            <Border Background="{DynamicResource DangerBgBrush}" CornerRadius="0" Padding="14" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Low stock: Whole Milk" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Only 4 liters left" FontSize="12"
                                                   Foreground="{DynamicResource Gray500Brush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource WarningBgBrush}" CornerRadius="0" Padding="14" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Terminal offline" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Quezon City – Terminal 3" FontSize="12"
                                                   Foreground="{DynamicResource Gray500Brush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource InfoBgBrush}" CornerRadius="0" Padding="14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ℹ" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Shift ending soon" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Cashier Juan – 25 mins left" FontSize="12"
                                                   Foreground="{DynamicResource Gray500Brush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
