<UserControl x:Class="POSSystem.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Multi-branch Point of Sale System" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- KPI Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#007AFF"/>
                    <TextBlock Text="Today's Sales" FontSize="12.5" Foreground="#8E8E93" Margin="0,10,0,4"/>
                    <TextBlock Text="₱0.00" FontSize="22" FontWeight="Bold" Foreground="#1C1C1E"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="5,0,5,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#34C759"/>
                    <TextBlock Text="Transactions" FontSize="12.5" Foreground="#8E8E93" Margin="0,10,0,4"/>
                    <TextBlock Text="0" FontSize="22" FontWeight="Bold" Foreground="#1C1C1E"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="5,0,5,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#5856D6"/>
                    <TextBlock Text="Products" FontSize="12.5" Foreground="#8E8E93" Margin="0,10,0,4"/>
                    <TextBlock Text="—" FontSize="22" FontWeight="Bold" Foreground="#1C1C1E"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="10,0,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#FF9500"/>
                    <TextBlock Text="Active Users" FontSize="12.5" Foreground="#8E8E93" Margin="0,10,0,4"/>
                    <TextBlock Text="1" FontSize="22" FontWeight="Bold" Foreground="#1C1C1E"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Welcome card -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorder}"
                VerticalAlignment="Top"
                MaxWidth="620"
                HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           FontSize="14.5"
                           LineHeight="22"
                           Foreground="#1C1C1E"/>

                <Border Background="#F2F2F7"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="System Status"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#8E8E93"/>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="13.5"
                                   Text="{Binding DatabaseStatus, StringFormat=Database: {0}}"
                                   TextWrapping="Wrap"
                                   Foreground="#1C1C1E"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3"
                   HorizontalAlignment="Right"
                   FontSize="12"
                   Foreground="#AEAEB2"
                   Text="{Binding VersionDisplay, Mode=OneWay}"
                   Margin="0,12,0,0"/>
    </Grid>
</UserControl>