<Window x:Class="POSSystem.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POS System — Sign In"
        Height="560"
        Width="430"
        MinHeight="520"
        MinWidth="390"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        FontFamily="{StaticResource AppFont}">

    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/POSSystem.Desktop;component/Assets/FODPOS-LOGO.png"/>
    </Window.Icon>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F172A" Offset="0"/>
                <GradientStop Color="#111827" Offset="0.5"/>
                <GradientStop Color="#0B1120" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="360"
                MaxWidth="360"
                CornerRadius="24"
                Background="{StaticResource SurfaceBrush}"
                VerticalAlignment="Center"
                Padding="26">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="12" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Width="92" Height="92" CornerRadius="18" Background="#F8FAFC" Padding="12">
                        <Image Source="pack://application:,,,/POSSystem.Desktop;component/Assets/FODPOS-LOGO.png"
                               Stretch="Uniform"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="Welcome back"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Sign in to continue your shift"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>

                <TextBlock Text="Username"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBox}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Password"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource InputPasswordBox}"
                             MinHeight="42"
                             PasswordChanged="PasswordBox_OnPasswordChanged"
                             Margin="0,0,0,8"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           MinHeight="18"
                           Margin="0,0,0,14"/>

                <Button Content="Sign In"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Height="46"
                        HorizontalAlignment="Stretch"/>

                <TextBlock Text="Demo accounts available in the app docs"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           Margin="16,18,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
