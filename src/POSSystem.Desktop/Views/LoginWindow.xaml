<Window x:Class="POSSystem.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Width="850" Height="520" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Premium Colors -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#3B82F6"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#2563EB"/>
        <SolidColorBrush x:Key="BackgroundDeep" Color="#0F172A"/>
        <SolidColorBrush x:Key="BackgroundLighter" Color="#334155"/> 
        <SolidColorBrush x:Key="BackgroundSurface" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Main Rounded Card -->
    <Border Background="{StaticResource BackgroundSurface}" CornerRadius="16" Effect="{StaticResource ShadowEffect}" Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*"/>
                <ColumnDefinition Width="0.6*"/>
            </Grid.ColumnDefinitions>

            <!-- Custom Close Button -->
            <Button Grid.ColumnSpan="2" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,15,0" Click="CloseButton_Click" Cursor="Hand" FontSize="16"/>

            <!-- Left Branding Section -->
            <Grid Grid.Column="0" Background="{StaticResource PrimaryColor}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🛒" FontSize="56" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="PREMIUM POS" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,15,0,0"/>
                    <TextBlock Text="Complete Retail System" FontSize="14" Foreground="#E0E7FF" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Right Login Form Section -->
            <Grid Grid.Column="1" Background="{StaticResource BackgroundDeep}">
                <Grid>
                    <!-- Login Form -->
                    <StackPanel VerticalAlignment="Center" Margin="45,0">
                        <TextBlock Text="Welcome Back" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                        <TextBlock Text="Sign in to your account to continue" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,35"/>

                        <TextBlock Text="Email" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,5,5"/>
                        <Border CornerRadius="8" Background="{StaticResource BackgroundSurface}" BorderBrush="{StaticResource BackgroundLighter}" BorderThickness="1" Height="45" Margin="0,0,0,20">
                            <TextBox x:Name="UserNameTextBox" 
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="16" Foreground="{StaticResource TextPrimary}" 
                                     Background="Transparent" BorderThickness="0" Padding="10" VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Password" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,5,5"/>
                        <Border CornerRadius="8" Background="{StaticResource BackgroundSurface}" BorderBrush="{StaticResource BackgroundLighter}" BorderThickness="1" Height="45" Margin="0,0,0,15">
                            <!-- ✅ FIX: ADDED THE MISSING PASSWORDCHANGED EVENT HERE -->
                            <PasswordBox x:Name="PasswordBox" 
                                         PasswordChanged="PasswordBox_OnPasswordChanged"
                                         FontSize="16" Foreground="{StaticResource TextPrimary}" 
                                         Background="Transparent" BorderThickness="0" Padding="10" 
                                         VerticalContentAlignment="Center" PasswordChar="●" />
                        </Border>

                        <TextBlock Text="{Binding ErrorMessage}" 
                                   Foreground="#EF4444" 
                                   FontSize="13" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,5,0,15" 
                                   TextWrapping="Wrap" 
                                   MaxWidth="300"/>

                        <Button Content="SIGN IN" 
                                Command="{Binding LoginCommand}" 
                                FontSize="15" FontWeight="Bold" 
                                Background="{StaticResource PrimaryColor}" Foreground="White" BorderThickness="0" Height="50" Margin="0,0,0,5" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#334155" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Loading Overlay -->
                    <Border Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="40" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock Text="Authenticating..." FontSize="16" Foreground="White" FontWeight="Bold" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>