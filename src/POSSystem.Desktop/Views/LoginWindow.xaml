<Window x:Class="POSSystem.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POS System — Sign In"
        Height="600"
        Width="440"
        MinHeight="580"
        MinWidth="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SidebarBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/POSSystem.Desktop;component/Assets/FODPOS-LOGO.png"/>
    </Window.Icon>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Slate950Color}" Offset="0"/>
                <GradientStop Color="{StaticResource Slate900Color}" Offset="0.5"/>
                <GradientStop Color="{StaticResource Slate800Color}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="380"
                MaxWidth="380"
                CornerRadius="24"
                Background="{StaticResource SurfaceBrush}"
                VerticalAlignment="Center"
                Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="12" Opacity="0.18" Color="{StaticResource ShadowColor}"/>
            </Border.Effect>

            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Width="88" Height="88" CornerRadius="20" Background="{StaticResource LogoTileGradientBrush}" Padding="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.15" Color="{StaticResource ShadowColor}"/>
                        </Border.Effect>
                        <Image Source="pack://application:,,,/POSSystem.Desktop;component/Assets/FODPOS-LOGO.png"
                               Stretch="Uniform"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="Welcome back"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Sign in to continue your shift"
                           FontSize="13.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <TextBlock Text="Username"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBox}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Password"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource InputPasswordBox}"
                             MinHeight="44"
                             PasswordChanged="PasswordBox_OnPasswordChanged"
                             Margin="0,0,0,10"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap"
                           FontSize="12.5"
                           MinHeight="18"
                           Margin="0,0,0,16"/>

                <Button Content="Sign In"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Height="46"
                        HorizontalAlignment="Stretch"/>

                <TextBlock Text="Demo accounts available in the app docs"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           Margin="0,18,0,0"
                           Opacity="0.7"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
