<Window x:Class="POSSystem.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:POSSystem.Desktop.ViewModels"
        xmlns:views="clr-namespace:POSSystem.Desktop.Views"
        xmlns:conv="clr-namespace:POSSystem.Desktop.Converters"
        Title="POS System"
        Height="720"
        Width="1100"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundGradientBrush}"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/POSSystem.Desktop;component/Assets/FODPOS-LOGO.png">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RolePermissionsViewModel}">
            <views:RolePermissionsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR ===================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradientBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo card -->
                <Border Grid.Row="0" Margin="20,22,20,16" Padding="20,22" CornerRadius="20" Background="#1E293B"
                        BorderBrush="#334155" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource LogoTileGradientBrush}" Padding="7">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.25" Color="#000000"/>
                            </Border.Effect>
                            <Image Source="pack://application:,,,/POSSystem.Desktop;component/Assets/FODPOS-LOGO.png"
                                   Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="FOD POS"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentLightBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,2"/>
                        <TextBlock Text="RETAIL OPERATIONS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextOnDarkBrush}"
                                   Opacity="0.45"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <Border Height="2" Width="28" Margin="0,0,0,0" CornerRadius="1"
                                Background="{StaticResource AccentGradientBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="10,10,10,0">
                    <TextBlock Text="MENU"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextOnDarkBrush}"
                               Opacity="0.35"
                               Margin="20,0,0,10"/>

                    <Button Tag="dashboard"
                            Command="{Binding NavigateDashboardCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanViewDashboard, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="pos"
                            Command="{Binding NavigatePosCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="POS Terminal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="products"
                            Command="{Binding NavigateProductsCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Products" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="reports"
                            Style="{StaticResource NavButton}"
                            IsEnabled="False"
                            Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Reports" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="permissions"
                            Command="{Binding NavigatePermissionsCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanManagePermissions, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Role Permissions" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer: user card + sign out -->
                <StackPanel Grid.Row="2" Margin="16,0,16,20">
                    <Border Background="#1E293B" CornerRadius="16" Padding="14" Margin="0,0,0,14"
                            BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentGradientBrush}">
                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WelcomeName}"
                                           Foreground="{StaticResource TextOnDarkBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"/>
                                <TextBlock Text="{Binding RoleName}"
                                           Foreground="{StaticResource TextOnDarkBrush}"
                                           Opacity="0.55"
                                           FontSize="11"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="Sign Out"
                            Style="{StaticResource SecondaryButton}"
                            Foreground="{StaticResource TextOnDarkBrush}"
                            Background="#1E293B"
                            BorderBrush="#334155"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== CONTENT ===================== -->
        <Border Grid.Column="1" Background="Transparent" Padding="24">
            <Border CornerRadius="24" Background="{StaticResource CardHighlightBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.05" Color="{StaticResource ShadowColor}"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource AccentGradientBrush}"
                            CornerRadius="24,24,0,0"/>
                    <ContentControl Grid.Row="1" Margin="24" Content="{Binding CurrentView}"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
