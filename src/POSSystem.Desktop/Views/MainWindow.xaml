<!--MainWindow.xaml-->
<Window x:Class="POSSystem.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:POSSystem.Desktop.ViewModels"
        xmlns:views="clr-namespace:POSSystem.Desktop.Views"
        xmlns:conv="clr-namespace:POSSystem.Desktop.Converters"
        x:Name="RootWindow"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Title="POS System"
        Height="720"
        Width="1100"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Gray50Brush}"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/POSSystem.Desktop;component/Assets/jnri-pos-logo.png">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToEmojiConverter x:Key="BoolToEmoji"/>

        <DropShadowEffect x:Key="HeaderShadow" BlurRadius="12" ShadowDepth="4" Opacity="0.06" Color="#000"/>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PromoProductsViewModel}">
            <views:PromoProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BranchProductListingViewModel}">
            <views:BranchProductListingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RolePermissionsViewModel}">
            <views:RolePermissionsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Effect="{StaticResource HeaderShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Border Grid.Column="0" Padding="24,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" Background="{DynamicResource PrimaryGradient}">
                            <Image Source="pack://application:,,,/POSSystem.Desktop;component/Assets/jnri-pos-logo.png"
                                   Stretch="Uniform" Margin="4"/>
                        </Border>
                        <TextBlock Text="FOD POS" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Gray800Brush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel x:Name="HeaderNavPanel" Grid.Column="1" 
                            Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Tag="dashboard" Content="Dashboard"
                            Command="{Binding NavigateDashboardCommand}"
                            Style="{StaticResource HeaderNavButton}"
                            Visibility="{Binding CanViewDashboard, Converter={StaticResource BoolToVis}}"/>
                    <Button Tag="pos" Content="Point of Sale"
                            Command="{Binding NavigatePosCommand}"
                            Style="{StaticResource HeaderNavButton}"
                            Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}"/>
                    <ToggleButton x:Name="ProductsToggle" Tag="products" Content="Products  ▼"
                                  Style="{StaticResource HeaderNavButton}"
                                  Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}"
                                  IsChecked="{Binding IsProductsMenuOpen, Mode=TwoWay}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource Gray100Brush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsProductsMenuOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ProductsToggle}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Effect="{StaticResource ShadowMedium}"
                                MinWidth="220">
                            <StackPanel>
                                <Button Content="Product Master"
                                        Command="{Binding NavigateProductsCommand}"
                                        Style="{StaticResource ModernMenuItemButton}"/>
                                <Button Content="Promo Products"
                                        Command="{Binding NavigatePromoProductsCommand}"
                                        Style="{StaticResource ModernMenuItemButton}"/>
                                <Button Content="Branch Product Listing"
                                        Command="{Binding NavigateBranchProductListingCommand}"
                                        Style="{StaticResource ModernMenuItemButton}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Tag="reports" Content="Reports"
                            Style="{StaticResource HeaderNavButton}"
                            IsEnabled="False"
                            Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVis}}"/>
                    <Button Tag="permissions" Content="Permissions"
                            Command="{Binding NavigatePermissionsCommand}"
                            Style="{StaticResource HeaderNavButton}"
                            Visibility="{Binding CanManagePermissions, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- User Section -->
                <Border Grid.Column="2" Padding="24,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" Background="{DynamicResource PrimaryLightBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WelcomeName, Converter={StaticResource BoolToEmoji}}"
                                       FontFamily="Segoe UI Emoji" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WelcomeName}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Gray800Brush}"/>
                            <TextBlock Text="{Binding RoleName}" FontSize="10"
                                       Foreground="{DynamicResource Gray500Brush}"/>
                        </StackPanel>
                        <Button Command="{Binding ToggleDarkModeCommand}"
                                Style="{StaticResource IconButton}"
                                Margin="10,0,0,0"
                                ToolTip="Toggle Theme">
                            <TextBlock Text="&#xE793;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                        </Button>
                        <Button Command="{Binding LogoutCommand}"
                                Style="{StaticResource IconButton}"
                                Margin="2,0,0,0"
                                ToolTip="Sign Out">
                            <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENT AREA -->
        <Border Grid.Row="1" Background="{DynamicResource Gray50Brush}" Padding="32,24,32,24">
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource ShadowMedium}">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Border>
    </Grid>
</Window>
