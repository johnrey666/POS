<!--Mainwindow.xaml-->
<Window x:Class="POSSystem.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:POSSystem.Desktop.ViewModels"
        xmlns:views="clr-namespace:POSSystem.Desktop.Views"
        xmlns:conv="clr-namespace:POSSystem.Desktop.Converters"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Title="POS System"
        Height="720"
        Width="1100"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Inter, Segoe UI Variable, Segoe UI, sans-serif"
        Icon="pack://application:,,,/POSSystem.Desktop;component/Assets/jnri-pos-logo.png">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToEmojiConverter x:Key="BoolToEmoji"/>

        <DropShadowEffect x:Key="ContentShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.07" Color="#000000"/>

        <!-- Top navigation link style -->
        <Style x:Key="TopNavLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopNavLinkActive" BasedOn="{StaticResource TopNavLink}" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
        </Style>

        <!-- DataTemplates -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RolePermissionsViewModel}">
            <views:RolePermissionsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== TOP NAVIGATION BAR ========== -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}">
                        <Image Source="pack://application:,,,/POSSystem.Desktop;component/Assets/jnri-pos-logo.png"
                               Stretch="Uniform" Margin="4"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="FOD POS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="RETAIL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Navigation Links -->
                <StackPanel x:Name="NavLinksStackPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Tag="dashboard"
                            Command="{Binding NavigateDashboardCommand}"
                            Style="{StaticResource TopNavLink}"
                            Visibility="{Binding CanViewDashboard, Converter={StaticResource BoolToVis}}">
                        Dashboard
                    </Button>
                    <Button Tag="pos"
                            Command="{Binding NavigatePosCommand}"
                            Style="{StaticResource TopNavLink}"
                            Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}">
                        POS
                    </Button>
                    <Button Tag="products"
                            Command="{Binding NavigateProductsCommand}"
                            Style="{StaticResource TopNavLink}"
                            Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}">
                        Products
                    </Button>
                    <Button Tag="reports"
                            Style="{StaticResource TopNavLink}"
                            IsEnabled="False"
                            Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVis}}">
                        Reports
                    </Button>
                    <Button Tag="permissions"
                            Command="{Binding NavigatePermissionsCommand}"
                            Style="{StaticResource TopNavLink}"
                            Visibility="{Binding CanManagePermissions, Converter={StaticResource BoolToVis}}">
                        Permissions
                    </Button>
                </StackPanel>

                <!-- ========== RIGHT: USER DROPDOWN ========== -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <!-- Dropdown Trigger Button -->
                    <ToggleButton x:Name="UserDropdownToggle"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding WelcomeName}" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Dropdown Popup -->
                    <Popup IsOpen="{Binding IsChecked, ElementName=UserDropdownToggle}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=UserDropdownToggle}"
                           AllowsTransparency="True"
                           StaysOpen="False">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6"
                                Effect="{StaticResource SoftShadow}"
                                MinWidth="170">
                            <StackPanel>
                                
                                <!-- Dropdown Item: Dark Mode -->
                                <Button Command="{Binding ToggleDarkModeCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="12,8"
                                        HorizontalContentAlignment="Left"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IsDarkMode, Converter={StaticResource BoolToEmoji}}" 
                                                   FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Toggle Theme" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium"/>
                                    </StackPanel>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="4,4"/>

                                <!-- Dropdown Item: Sign Out -->
                                <Button Command="{Binding LogoutCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="12,8"
                                        HorizontalContentAlignment="Left"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Sign Out" FontSize="13" FontWeight="Medium"/>
                                    </StackPanel>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </StackPanel>
                        </Border>
                    </Popup>

                </StackPanel>
                <!-- ========== END USER DROPDOWN ========== -->

            </Grid>
        </Border>

        <!-- ========== CONTENT AREA ========== -->
        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" Padding="20,16,20,20">
            <Border CornerRadius="16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource ContentShadow}">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Border>
    </Grid>
</Window>