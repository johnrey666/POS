<Window x:Class="POSSystem.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:POSSystem.Desktop.ViewModels"
        xmlns:views="clr-namespace:POSSystem.Desktop.Views"
        xmlns:conv="clr-namespace:POSSystem.Desktop.Converters"
        WindowState="Maximized"
        Title="POS System"
        Height="720"
        Width="1100"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/POSSystem.Desktop;component/Assets/FODPOS-LOGO.png">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RolePermissionsViewModel}">
            <views:RolePermissionsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== SIDEBAR – Glass effect ========== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradientBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.15" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Margin="16,20,16,14" Padding="16,18" CornerRadius="18"
                        Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="14"
                                Background="{StaticResource AccentGradientBrush}" Padding="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" Color="{StaticResource AccentStart}"/>
                            </Border.Effect>
                            <Image Source="pack://application:,,,/POSSystem.Desktop;component/Assets/FODPOS-LOGO.png"
                                   Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="FOD POS"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="RETAIL OPS"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="8,4,8,0">
                    <TextBlock Text="MENU"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="16,8,0,12"/>

                    <Button Tag="dashboard"
                            Command="{Binding NavigateDashboardCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanViewDashboard, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="pos"
                            Command="{Binding NavigatePosCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="POS Terminal" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="products"
                            Command="{Binding NavigateProductsCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Products" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="reports"
                            Style="{StaticResource NavButton}"
                            IsEnabled="False"
                            Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Reports" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="permissions"
                            Command="{Binding NavigatePermissionsCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanManagePermissions, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Role Permissions" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- User Card -->
                <StackPanel Grid.Row="2" Margin="12,0,12,16">
                    <Border Background="#20FFFFFF" CornerRadius="16" Padding="14" Margin="0,0,0,12"
                            BorderBrush="#30FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Background="{StaticResource AccentGradientBrush}">
                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WelcomeName}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding RoleName}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Opacity="0.6"
                                           FontSize="11"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="Sign Out"
                            Style="{StaticResource SecondaryButton}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Background="#15FFFFFF"
                            BorderBrush="#30FFFFFF"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== CONTENT AREA ========== -->
        <Border Grid.Column="1" Background="Transparent" Padding="20">
            <Border CornerRadius="24"
                    Background="{StaticResource SurfaceMediumBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="12" Opacity="0.08" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource AccentGradientBrush}"
                            CornerRadius="24,24,0,0"/>
                    <ContentControl Grid.Row="1" Margin="0,0,0,0" Content="{Binding CurrentView}"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>