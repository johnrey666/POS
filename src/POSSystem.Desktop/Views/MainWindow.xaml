<Window x:Class="POSSystem.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:POSSystem.Desktop.ViewModels"
        xmlns:views="clr-namespace:POSSystem.Desktop.Views"
        xmlns:conv="clr-namespace:POSSystem.Desktop.Converters"
        Title="POS System"
        Height="680"
        Width="1040"
        MinHeight="560"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundGradientBrush}"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/POSSystem.Desktop;component/Assets/FODPOS-LOGO.png">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RolePermissionsViewModel}">
            <views:RolePermissionsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR ===================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradientBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo card -->
                <Border Grid.Row="0" Margin="18,20,18,12" Padding="18,20" CornerRadius="20" Background="#0F1B2E"
                        BorderBrush="#1C2A44" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource LogoTileGradientBrush}" Padding="7">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <Image Source="pack://application:,,,/POSSystem.Desktop;component/Assets/FODPOS-LOGO.png"
                                   Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="FOD POS"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentLightBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="RETAIL OPERATIONS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextOnDarkBrush}"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0"/>
                        <Border Height="2" Width="34" Margin="0,12,0,0" CornerRadius="1"
                                Background="{StaticResource AccentGradientBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="10,10,10,0">
                    <TextBlock Text="MENU"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextOnDarkBrush}"
                               Opacity="0.4"
                               Margin="20,0,0,10"/>

                    <Button Tag="dashboard"
                            Command="{Binding NavigateDashboardCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanViewDashboard, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="pos"
                            Command="{Binding NavigatePosCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="POS Terminal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="products"
                            Command="{Binding NavigateProductsCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Products" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="reports"
                            Style="{StaticResource NavButton}"
                            IsEnabled="False"
                            Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Reports" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="permissions"
                            Command="{Binding NavigatePermissionsCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanManagePermissions, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Role Permissions" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer: user card + sign out -->
                <StackPanel Grid.Row="2" Margin="16,0,16,20">
                    <Border Background="#FFFFFF0D" CornerRadius="16" Padding="14" Margin="0,0,0,12"
                            BorderBrush="#FFFFFF14" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentGradientBrush}">
                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WelcomeName}"
                                           Foreground="{StaticResource TextOnDarkBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding RoleName}"
                                           Foreground="{StaticResource TextOnDarkBrush}"
                                           Opacity="0.6"
                                           FontSize="11"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="Sign Out"
                            Style="{StaticResource SecondaryButton}"
                            Foreground="{StaticResource TextOnDarkBrush}"
                            Background="#151F35"
                            BorderBrush="#243252"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== CONTENT ===================== -->
        <Border Grid.Column="1" Background="Transparent" Padding="22">
            <Border CornerRadius="26" Background="{StaticResource CardHighlightBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.06" Color="#0B1220"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource AccentGradientBrush}"
                            CornerRadius="26,26,0,0"/>
                    <ContentControl Grid.Row="1" Margin="20" Content="{Binding CurrentView}"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
