<Window x:Class="POSSystem.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:POSSystem.Desktop.ViewModels"
        xmlns:views="clr-namespace:POSSystem.Desktop.Views"
        xmlns:conv="clr-namespace:POSSystem.Desktop.Converters"
        WindowState="Maximized"
        Title="POS System"
        Height="720"
        Width="1100"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F7"
        FontFamily="Inter, Segoe UI Variable, Segoe UI, sans-serif"
        Icon="pack://application:,,,/POSSystem.Desktop;component/Assets/FODPOS-LOGO.png">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Local fallbacks so the window never crashes on missing resources -->
        <DropShadowEffect x:Key="LocalSoftShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.07" Color="#000000"/>

        <LinearGradientBrush x:Key="LocalAccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#007AFF" Offset="0"/>
            <GradientStop Color="#5856D6" Offset="0.55"/>
            <GradientStop Color="#AF52DE" Offset="1"/>
        </LinearGradientBrush>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RolePermissionsViewModel}">
            <views:RolePermissionsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== SIDEBAR ========== -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E5EA" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0"
                        Margin="14,18,14,12"
                        Padding="14,16"
                        CornerRadius="14"
                        Background="#F2F2F7">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="12"
                                Background="{StaticResource LocalAccentGradient}">
                            <Image Source="pack://application:,,,/POSSystem.Desktop;component/Assets/FODPOS-LOGO.png"
                                   Stretch="Uniform"
                                   Margin="6"/>
                        </Border>
                        <TextBlock Text="FOD POS"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#1C1C1E"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="RETAIL OPS"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#8E8E93"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="6,2,6,0">
                    <TextBlock Text="MENU"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#AEAEB2"
                               Margin="14,6,0,10"/>

                    <Button Tag="dashboard"
                            Command="{Binding NavigateDashboardCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanViewDashboard, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="pos"
                            Command="{Binding NavigatePosCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="POS Terminal" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="products"
                            Command="{Binding NavigateProductsCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanAccessPos, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Products" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="reports"
                            Style="{StaticResource NavButton}"
                            IsEnabled="False"
                            Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Reports" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="permissions"
                            Command="{Binding NavigatePermissionsCommand}"
                            Style="{StaticResource NavButton}"
                            Visibility="{Binding CanManagePermissions, Converter={StaticResource BoolToVis}}"
                            Loaded="NavButton_Loaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Role Permissions" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- User Card -->
                <StackPanel Grid.Row="2" Margin="10,0,10,14">
                    <Border Background="#F2F2F7"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource LocalAccentGradient}">
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WelcomeName}"
                                           Foreground="#1C1C1E"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding RoleName}"
                                           Foreground="#8E8E93"
                                           FontSize="11"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="Sign Out"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding LogoutCommand}"
                            Padding="14,10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== CONTENT AREA ========== -->
        <Border Grid.Column="1" Background="#F2F2F7" Padding="16">
            <Border CornerRadius="18"
                    Background="White"
                    BorderBrush="#E5E5EA"
                    BorderThickness="1"
                    Effect="{StaticResource LocalSoftShadow}">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Border>
    </Grid>
</Window>