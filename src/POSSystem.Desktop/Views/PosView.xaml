<UserControl x:Class="POSSystem.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:POSSystem.Desktop.ViewModels">
    <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="0.8*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== LEFT: CATALOG ========== -->
        <Grid Grid.Column="0" Margin="20,16,16,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="18" Background="Transparent"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0"
                    Padding="0" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="POS Terminal" Style="{StaticResource PageTitle}" FontSize="22"/>
                        <TextBlock Text="Search, select, and sell items quickly." Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#15FFFFFF" CornerRadius="10" Padding="12,7" Margin="0,0,0,4"
                                BorderBrush="#30FFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource AccentGlowBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BranchName, StringFormat=Branch: {0}}"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding TerminalName, StringFormat=Terminal: {0}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search + Category -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             Height="44"
                             Padding="42,10,14,10"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource SurfaceMediumBrush}"
                        CornerRadius="12" BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" Padding="8,0" Height="44">
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource PillComboBox}"
                              VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Product Grid -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14" Background="{StaticResource SurfaceMediumBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="155" Height="120" Margin="6"
                                        Style="{StaticResource ProductCardBorder}"
                                        Padding="14">
                                    <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,4,0,0" FontSize="10.5"/>
                                            </StackPanel>
                                            <Border Grid.Row="1" Style="{StaticResource PriceBadge}" HorizontalAlignment="Left" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding SellingPrice, StringFormat=₱{0:N2}}"
                                                           FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextOnAccentBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ========== RIGHT: CART ========== -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="0" Margin="16,16,20,20"
                Background="{StaticResource SurfaceMediumBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cart Header -->
                <Border Grid.Row="0" CornerRadius="20,20,0,0" Background="{StaticResource CartHeaderGradientBrush}"
                        Padding="20,16" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{StaticResource AccentGlowBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Cart" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="18" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding Cart.Count, StringFormat=({0} items)}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Cart Items -->
                <DataGrid Grid.Row="1"
                          Margin="12,8,12,0"
                          ItemsSource="{Binding Cart}"
                          Style="{StaticResource PremiumDataGrid}"
                          ColumnHeaderStyle="{StaticResource PremiumColumnHeader}"
                          RowStyle="{StaticResource PremiumRow}"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="44" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=₱{0:N2}}" Width="90" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="" Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="−" Style="{StaticResource QuantityButton}"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="+" Style="{StaticResource QuantityButton}" Margin="4,0,0,0"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Cart Footer -->
                <StackPanel Grid.Row="2" Margin="16,12,16,16">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12.5"/>

                    <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="14" Padding="16,14"
                            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Subtotal" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat=₱{0:N2}}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tax (12%)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding Tax, StringFormat=₱{0:N2}}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,10,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Total" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=₱{0:N2}}" HorizontalAlignment="Right"
                                           FontWeight="Bold" FontSize="20" Foreground="{StaticResource AccentGlowBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Hold" Margin="0,0,6,0" Command="{Binding HoldSaleCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button Grid.Column="1" Content="Clear" Margin="6,0,0,0" Command="{Binding ClearCartCommand}" Style="{StaticResource DangerOutlineButton}"/>
                    </Grid>
                    <Button Content="Checkout" Margin="0,10,0,0" Command="{Binding CheckoutCommand}" Style="{StaticResource PrimaryButton}" Height="48"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>