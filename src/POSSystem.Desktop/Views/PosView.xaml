<UserControl x:Class="POSSystem.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="CategoryListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="CategoryListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,10" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*"/>
            <ColumnDefinition Width="0.75*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: CATALOG -->
        <Grid Grid.Column="0" Margin="18,14,10,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="POS Terminal" Style="{StaticResource PageTitle}" FontSize="22"/>
                    <TextBlock Text="Search, select, and sell items quickly." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="8" Padding="10,5" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BranchName, StringFormat=Branch: {0}}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding TerminalName, StringFormat=Terminal: {0}}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- Search -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBox}"
                         Height="42"
                         Padding="40,0,12,0"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,0,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            </Grid>

            <!-- Categories + Products -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Category Sidebar -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="8,4,0,10" Opacity="0.85"/>

                        <ListBox Style="{StaticResource CategoryListBox}"
                                 ItemContainerStyle="{StaticResource CategoryListBoxItem}"
                                 ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Product Grid -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="152" Height="122" Margin="5"
                                            Style="{StaticResource ProductCardBorder}" Padding="12">
                                        <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                                                               MaxHeight="40"/>
                                                    <TextBlock Text="{Binding CategoryName}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,4,0,0" FontSize="11"/>
                                                </StackPanel>
                                                <Border Grid.Row="1" Style="{StaticResource PriceBadge}"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding SellingPrice, StringFormat=₱{0:N2}}"
                                                               FontWeight="Bold" FontSize="12"
                                                               Foreground="{DynamicResource TextOnAccentBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- RIGHT: CART -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="0" Margin="6,14,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cart Header -->
                <Border Grid.Row="0" CornerRadius="14,14,0,0"
                        Background="{DynamicResource SurfaceSecondaryBrush}"
                        Padding="16,13" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Cart" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="Bold" FontSize="16" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Cart.Count, StringFormat=({0})}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Cart Items -->
                <DataGrid Grid.Row="1" Margin="8,6,8,0"
                          ItemsSource="{Binding Cart}"
                          Style="{StaticResource PremiumDataGrid}"
                          ColumnHeaderStyle="{StaticResource PremiumColumnHeader}"
                          RowStyle="{StaticResource PremiumRow}"
                          Background="Transparent"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="40" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=₱{0:N2}}" Width="78" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="" Width="68">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="−" Style="{StaticResource QuantityButton}"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="+" Style="{StaticResource QuantityButton}" Margin="3,0,0,0"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Cart Footer -->
                <StackPanel Grid.Row="2" Margin="12,8,12,12">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource SuccessBrush}"
                               Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12.5"/>

                    <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                            CornerRadius="10" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total" FontWeight="Bold" FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=₱{0:N2}}"
                                       HorizontalAlignment="Right" FontWeight="Bold" FontSize="20"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Hold" Margin="0,0,5,0"
                                Command="{Binding HoldSaleCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button Grid.Column="1" Content="Clear" Margin="5,0,0,0"
                                Command="{Binding ClearCartCommand}" Style="{StaticResource DangerOutlineButton}"/>
                    </Grid>

                    <Button Content="Checkout" Margin="0,8,0,0"
                            Command="{Binding CheckoutCommand}"
                            Style="{StaticResource PrimaryButton}" Height="46"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>