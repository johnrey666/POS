<UserControl x:Class="POSSystem.Desktop.Views.PosView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="CategoryPill" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Gray100Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Gray700Brush}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Gray200Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="0.8*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: CATALOG -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputField}"
                         Height="44"
                         Padding="16,0,44,0"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{DynamicResource Gray400Brush}" Margin="16,0,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            </Grid>

            <!-- Categories -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}"
                                    Style="{StaticResource CategoryPill}"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,8,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Product Grid -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="160" Height="120" Margin="8"
                                        Style="{StaticResource CardInteractive}" Padding="16">
                                    <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Gray900Brush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CategoryName}"
                                                           Foreground="{DynamicResource Gray500Brush}"
                                                           Margin="0,4,0,0" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding SellingPrice, StringFormat=₱{0:N2}}"
                                                       FontWeight="Bold" FontSize="12"
                                                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0"/>
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- RIGHT: CART -->
        <Border Grid.Column="2" Style="{StaticResource CardLarge}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cart Header -->
                <Border Grid.Row="0" Background="{DynamicResource Gray50Brush}"
                        Padding="16,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Cart" Foreground="{DynamicResource Gray900Brush}"
                                   FontWeight="Bold" FontSize="14" Margin="8,0,0,0"/>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="0" 
                                Padding="4,2" Margin="8,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Cart.Count, StringFormat={}{0} items}"
                                       Foreground="{DynamicResource Gray600Brush}" FontSize="11"
                                       FontWeight="Medium"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Cart Items -->
                <DataGrid Grid.Row="1" Margin="0,0,0,0"
                          ItemsSource="{Binding Cart}"
                          Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                          RowStyle="{StaticResource ModernRow}"
                          Background="Transparent"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          AutoGenerateColumns="False"
                          RowHeight="32"
                          ColumnHeaderHeight="32"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=₱{0:N2}}" Width="80" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="−" Style="{StaticResource IconButton}" FontSize="11" FontWeight="Bold"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="+" Style="{StaticResource IconButton}" FontSize="11" FontWeight="Bold" Margin="2,0,0,0"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="✕" Style="{StaticResource TextButtonDanger}" FontSize="11" FontWeight="Bold" Margin="2,0,0,0"
                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Cart Footer -->
                <Border Grid.Row="2" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12"/>

                        <Border Background="{DynamicResource Gray50Brush}"
                                CornerRadius="0" Padding="12,10"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource Gray600Brush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=₱{0:N2}}"
                                           HorizontalAlignment="Right" FontWeight="Bold" FontSize="20"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Hold" Margin="0,0,4,0"
                                    Command="{Binding HoldSaleCommand}" Style="{StaticResource SecondaryButton}" Height="34" FontSize="12"/>
                            <Button Grid.Column="1" Content="Clear" Margin="4,0,0,0"
                                    Command="{Binding ClearCartCommand}" Style="{StaticResource SecondaryButton}" Height="34" FontSize="12"/>
                        </Grid>

                        <Button Content="Checkout" Margin="0,0,0,0"
                                Command="{Binding CheckoutCommand}"
                                Style="{StaticResource PrimaryButton}" Height="42" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
