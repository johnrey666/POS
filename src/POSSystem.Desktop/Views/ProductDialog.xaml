<Window x:Class="POSSystem.Desktop.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product"
        Height="640"
        Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="White"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource SurfaceBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="0" 
            Effect="{StaticResource ShadowLarge}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource Gray50Brush}" 
                    Padding="24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="New Product" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Gray900Brush}" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" Width="32" Height="32"
                            Background="Transparent" BorderThickness="0" FontSize="14" 
                            Foreground="{DynamicResource Gray500Brush}"
                            Click="Close_Click" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel>

                    <!-- Image + ID Row -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="UploadImageButton" Grid.Column="0" Height="100" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" CornerRadius="0" Background="{DynamicResource Gray50Brush}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🖼" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Upload" FontSize="11" Foreground="{DynamicResource Gray500Brush}" 
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Product ID" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Gray700Brush}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource Gray50Brush}" BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" CornerRadius="0" Padding="10,8">
                                <TextBlock x:Name="ProductIdBox" Text="Auto-generated" 
                                           Foreground="{DynamicResource Gray400Brush}" FontSize="13"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Name + UOM + Price -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Product Name" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Gray700Brush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="NameBox" Height="40" Padding="12,0" VerticalContentAlignment="Center"
                                     Style="{StaticResource InputField}" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="UOM" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Gray700Brush}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="UomBox" Height="40" VerticalContentAlignment="Center"
                                      Style="{StaticResource ModernComboBox}" FontSize="13">
                                <ComboBoxItem Content="pc" IsSelected="True"/>
                                <ComboBoxItem Content="kg"/>
                                <ComboBoxItem Content="g"/>
                                <ComboBoxItem Content="L"/>
                                <ComboBoxItem Content="box"/>
                                <ComboBoxItem Content="pack"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="List Price" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Gray700Brush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="PriceBox" Height="40" Padding="12,0" VerticalContentAlignment="Center"
                                     Style="{StaticResource InputField}" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Raw Materials + Branches -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Raw Materials -->
                        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" CornerRadius="0" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Raw Materials" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Gray900Brush}" VerticalAlignment="Center"/>
                                    <Button Content="+ Add" HorizontalAlignment="Right" Padding="10,4" 
                                            FontSize="12" Click="AddRawMaterial_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                </Grid>
                                <StackPanel x:Name="RawMaterialsPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- Branches -->
                        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" CornerRadius="0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Available Branches" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Gray900Brush}" Margin="0,0,0,12"/>
                                <ListBox x:Name="BranchesList" Height="140" BorderThickness="0" 
                                         Background="Transparent" SelectionMode="Multiple" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Active -->
                    <StackPanel x:Name="ActivePanel" Margin="0,20,0,0" Visibility="Collapsed">
                        <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Gray700Brush}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ActiveYes" Content="Active" Margin="0,0,18,0" 
                                         IsChecked="True" FontSize="13"/>
                            <RadioButton x:Name="ActiveNo" Content="Inactive" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Gray50Brush}" 
                    Padding="24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel x:Name="ViewButtons" Orientation="Horizontal" 
                                HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button Content="Delete" Width="90" Height="36" Margin="0,0,8,0" 
                                FontSize="13" Style="{StaticResource SecondaryButton}" Click="Delete_Click"/>
                        <Button Content="Edit" Width="90" Height="36" Margin="0,0,8,0" 
                                FontSize="13" Style="{StaticResource SecondaryButton}" Click="Edit_Click"/>
                        <Button Content="Close" Width="90" Height="36" FontSize="13"
                                Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="EditButtons" Orientation="Horizontal" 
                                HorizontalAlignment="Right">
                        <Button Content="Cancel" Width="90" Height="36" Margin="0,0,8,0" 
                                FontSize="13" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                        <Button Content="Save" Width="100" Height="36" FontSize="13"
                                Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
