<Window x:Class="POSSystem.Desktop.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product"
        Height="560"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="White"
        ShowInTaskbar="False">

    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#F8F9FA" Padding="20,12" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="New Product" FontSize="16" FontWeight="Bold" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" Width="28" Height="28"
                            Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#666"
                            Click="Close_Click" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>

                    <!-- ROW 1: Image + Product ID -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Height="110" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Background="#FAFAFA">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🖼" FontSize="26" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Upload" FontSize="11" Foreground="#999" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="UploadImageButton" Background="Transparent" BorderThickness="0"
                                        Click="UploadImage_Click" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Product ID" FontSize="11" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,4"/>
                            <TextBox x:Name="ProductIdBox" Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#F4F4F4" FontSize="13"/>
                            <TextBlock Text="Auto-generated on save" FontSize="10" Foreground="#AAA" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 2: Name + UOM + Price -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Product Name" FontSize="11" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,4"/>
                            <TextBox x:Name="NameBox" Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                     Style="{StaticResource InputTextBox}" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="UOM" FontSize="11" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="UomBox" Height="34" VerticalContentAlignment="Center"
                                      Style="{StaticResource PillComboBox}" FontSize="13">
                                <ComboBoxItem Content="pc" IsSelected="True"/>
                                <ComboBoxItem Content="kg"/>
                                <ComboBoxItem Content="g"/>
                                <ComboBoxItem Content="L"/>
                                <ComboBoxItem Content="ml"/>
                                <ComboBoxItem Content="box"/>
                                <ComboBoxItem Content="pack"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="List Price" FontSize="11" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,4"/>
                            <TextBox x:Name="PriceBox" Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                     Style="{StaticResource InputTextBox}" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 3: Raw Materials + Branches -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Raw Materials -->
                        <Border Grid.Column="0" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Raw Materials" FontSize="12" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                                    <Button Content="+ Add" HorizontalAlignment="Right" Padding="8,3" FontSize="11"
                                            Click="AddRawMaterial_Click" Style="{StaticResource SecondaryButton}"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name" FontSize="10" Foreground="#999"/>
                                    <TextBlock Grid.Column="2" Text="UOM" FontSize="10" Foreground="#999"/>
                                    <TextBlock Grid.Column="4" Text="Qty" FontSize="10" Foreground="#999"/>
                                </Grid>

                                <StackPanel x:Name="RawMaterialsPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- Branches -->
                        <Border Grid.Column="2" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Add To Branch/es" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,8"/>
                                <ListBox x:Name="BranchesList" Height="140" BorderThickness="0" Background="Transparent"
                                         SelectionMode="Multiple" FontSize="12.5"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Active -->
                    <StackPanel x:Name="ActivePanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="Active" FontSize="11" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ActiveYes" Content="Yes" Margin="0,0,18,0" IsChecked="True" FontSize="12.5"/>
                            <RadioButton x:Name="ActiveNo" Content="No" FontSize="12.5"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8F9FA" Padding="20,12" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel x:Name="ViewButtons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button Content="Delete" Width="90" Height="34" Margin="0,0,8,0" FontSize="12.5"
                                Style="{StaticResource DangerOutlineButton}" Click="Delete_Click"/>
                        <Button Content="Edit" Width="90" Height="34" Margin="0,0,8,0" FontSize="12.5"
                                Style="{StaticResource SecondaryButton}" Click="Edit_Click"/>
                        <Button Content="Close" Width="90" Height="34" FontSize="12.5"
                                Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="EditButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Width="90" Height="34" Margin="0,0,8,0" FontSize="12.5"
                                Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                        <Button Content="Save" Width="100" Height="34" FontSize="12.5"
                                Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>