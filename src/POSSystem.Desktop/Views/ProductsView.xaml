<UserControl x:Class="POSSystem.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Products" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Manage product catalog and pricing." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Product Grid -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,20,0,0" Padding="0"
                Background="{StaticResource SurfaceMediumBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status -->
                <StackPanel Grid.Row="0" Margin="18,14,18,8">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Products}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          Style="{StaticResource PremiumDataGrid}"
                          ColumnHeaderStyle="{StaticResource PremiumColumnHeader}"
                          RowStyle="{StaticResource PremiumRow}"
                          Margin="0,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="140"/>
                        <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=₱{0:N2}}" Width="100"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=₱{0:N2}}" Width="100"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>