<!--ProductsView.xaml-->
<UserControl x:Class="POSSystem.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Products" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Manage product catalog and pricing." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,12,16,6">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource SuccessBrush}"
                               FontWeight="SemiBold"
                               FontSize="13"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Products}"
                          Style="{StaticResource PremiumDataGrid}"
                          ColumnHeaderStyle="{StaticResource PremiumColumnHeader}"
                          RowStyle="{StaticResource PremiumRow}"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="130"/>
                        <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=₱{0:N2}}" Width="90"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=₱{0:N2}}" Width="90"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>