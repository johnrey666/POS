<Window x:Class="POSSystem.Desktop.Views.PromoProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Promotional Product"
        Height="420"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="White"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource SurfaceBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="0" 
            Effect="{StaticResource ShadowLarge}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Gray50Brush}" 
                    Padding="24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="New Promotion" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Gray900Brush}" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" Width="32" Height="32"
                            Background="Transparent" BorderThickness="0" FontSize="14" 
                            Foreground="{DynamicResource Gray500Brush}"
                            Click="Close_Click" Cursor="Hand"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Product" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Gray700Brush}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ProductCombo" Height="40" VerticalContentAlignment="Center"
                                      Style="{StaticResource ModernComboBox}" FontSize="13"
                                      ItemsSource="{Binding Products}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding ProductId}">
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Gray900Brush}"/>
                                        <Setter Property="Padding" Value="14,10"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Gray50Brush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Gray700Brush}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ActiveYes" Content="Active" Margin="0,0,18,0" 
                                             IsChecked="True" FontSize="13"/>
                                <RadioButton x:Name="ActiveNo" Content="Inactive" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Start Date" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Gray700Brush}" Margin="0,0,0,6"/>
                            <DatePicker x:Name="StartDatePicker" Height="40" VerticalContentAlignment="Center"
                                        FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="End Date" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Gray700Brush}" Margin="0,0,0,6"/>
                            <DatePicker x:Name="EndDatePicker" Height="40" VerticalContentAlignment="Center"
                                        FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource Gray50Brush}" 
                    Padding="24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel x:Name="EditButtons" Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="90" Height="36" Margin="0,0,8,0" 
                            FontSize="13" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                    <Button Content="Save" Width="100" Height="36" FontSize="13"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
