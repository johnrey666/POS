<UserControl x:Class="POSSystem.Desktop.Views.PromoProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="+ New Promotion"
                        Height="40"
                        Padding="18,0"
                        FontSize="13"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewPromoCommand}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardLarge}" Padding="0">
                <DataGrid ItemsSource="{Binding PromoProducts}"
                          Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                          RowStyle="{StaticResource ModernRow}"
                          Background="Transparent"
                          SelectedItem="{Binding SelectedPromoProduct}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Active"
                                                Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="240" IsReadOnly="True"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat='MMM dd, yyyy'}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat='MMM dd, yyyy'}" Width="120" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Actions" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit"
                                                Style="{StaticResource TextButton}"
                                                Command="{Binding DataContext.EditPromoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="4,0"/>
                                        <Button Content="Delete"
                                                Style="{StaticResource TextButtonDanger}"
                                                Command="{Binding DataContext.DeletePromoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="4,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}"
                       Margin="0,12,0,0" FontSize="13"/>
        </Grid>
    </ScrollViewer>
</UserControl>
