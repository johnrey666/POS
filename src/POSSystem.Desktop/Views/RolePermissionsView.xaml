<UserControl x:Class="POSSystem.Desktop.Views.RolePermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Role Permissions" Style="{StaticResource Heading3}" Margin="0,0,0,2"/>
            <TextBlock Text="Select a role and configure what it can access"
                       Style="{StaticResource BodySmall}"/>
        </StackPanel>

        <!-- Role Selector -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Role" VerticalAlignment="Center" FontWeight="SemiBold"
                       FontSize="13" Foreground="{DynamicResource Gray700Brush}"/>
            
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}"
                      DisplayMemberPath="Name"
                      Height="36"
                      Style="{StaticResource ModernComboBox}"
                      FontSize="13">
                <ComboBox.Resources>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="{DynamicResource Gray900Brush}"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Gray50Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Resources>
            </ComboBox>
        </Grid>

        <!-- Permissions Table -->
        <Border Grid.Row="2" Style="{StaticResource CardLarge}" Padding="0">
            <DataGrid ItemsSource="{Binding Permissions}"
                      Style="{StaticResource ModernDataGrid}"
                      ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                      RowStyle="{StaticResource ModernRow}"
                      Background="Transparent"
                      RowHeight="36"
                      ColumnHeaderHeight="36"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Enabled"
                                            Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                            Width="80">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{DynamicResource Gray900Brush}"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="Permission" Binding="{Binding Name}" Width="260" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="160" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" 
                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}" 
                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
            <Button Content="Save Permissions"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Left"
                    Height="36"
                    Padding="20,0"
                    FontSize="13"/>
        </StackPanel>
    </Grid>
</UserControl>
