<UserControl x:Class="POSSystem.Desktop.Views.RolePermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Role Permissions" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Select a role and enable or disable what it can access."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,14">
            <TextBlock Text="Role"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="#8E8E93"
                       Margin="0,0,12,0"/>
            <ComboBox ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}"
                      DisplayMemberPath="Name"
                      MinWidth="230"
                      Height="42"
                      Padding="12,0"
                      Background="White"
                      Foreground="#1C1C1E"
                      BorderBrush="#E5E5EA"
                      BorderThickness="1.5"
                      VerticalContentAlignment="Center">
                <ComboBox.Resources>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#1C1C1E"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#007AFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Resources>
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Permissions}"
                      Style="{StaticResource PremiumDataGrid}"
                      ColumnHeaderStyle="{StaticResource PremiumColumnHeader}"
                      RowStyle="{StaticResource PremiumRow}"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Enabled"
                                            Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                            Width="80">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="Permission" Binding="{Binding Name}" Width="210" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="170" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF3B30" TextWrapping="Wrap" FontSize="13"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#34C759" TextWrapping="Wrap" FontSize="13"/>
            <Button Content="Save Permissions"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0"
                    Height="46"/>
        </StackPanel>
    </Grid>
</UserControl>