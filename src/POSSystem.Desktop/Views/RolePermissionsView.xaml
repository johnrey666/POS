<UserControl x:Class="POSSystem.Desktop.Views.RolePermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Role" VerticalAlignment="Center" FontWeight="SemiBold"
                       FontSize="12" Foreground="{DynamicResource Gray700Brush}"/>
            
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}"
                      DisplayMemberPath="Name"
                      Height="32"
                      Style="{StaticResource ModernComboBox}"
                      FontSize="12">
                <ComboBox.Resources>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="{DynamicResource Gray900Brush}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Gray50Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Resources>
            </ComboBox>

            <Button Grid.Column="4"
                    Content="Save Permissions"
                    Height="32"
                    Padding="12,0"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardLarge}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Gray50Brush}" 
                        Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" 
                               Foreground="{DynamicResource Gray600Brush}"/>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Permissions}"
                          Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                          RowStyle="{StaticResource ModernRow}"
                          Background="Transparent"
                          RowHeight="28"
                          ColumnHeaderHeight="28"
                          FontSize="11">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Enabled"
                                                Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                Width="70">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Gray900Brush}"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="Permission" Binding="{Binding Name}" Width="240" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" 
                   TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,28,0,0" HorizontalAlignment="Right">
            <Button Content="◀ Prev"
                    Height="28"
                    Padding="10,0"
                    FontSize="11"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding PreviousPageCommand}"
                    Margin="0,0,8,0"/>
            <TextBlock Text="{Binding CurrentPage, StringFormat=Page {}{0}}"
                       VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"
                       Foreground="{DynamicResource Gray600Brush}"/>
            <TextBlock Text="of" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"
                       Foreground="{DynamicResource Gray600Brush}"/>
            <TextBlock Text="{Binding TotalPages, StringFormat={}{0}}"
                       VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                       Foreground="{DynamicResource Gray600Brush}"/>
            <TextBlock Text="{Binding TotalItems, StringFormat={}{0} items}"
                       VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                       Foreground="{DynamicResource Gray500Brush}"/>
            <Button Content="Next ▶"
                    Height="28"
                    Padding="10,0"
                    FontSize="11"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding NextPageCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
