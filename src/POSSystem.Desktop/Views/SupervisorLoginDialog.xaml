<Window x:Class="POSSystem.Desktop.Views.SupervisorLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supervisor Access"
        Height="400"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="White"
        ShowInTaskbar="False"
        Effect="{StaticResource ShadowLarge}">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            Padding="32">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="32" Height="32" CornerRadius="0" Background="{DynamicResource PrimaryLightBrush}">
                        <TextBlock Text="🔐" FontSize="16" HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Supervisor Approval"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Gray900Brush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="ActionText"
                           Text="Please enter supervisor credentials to continue"
                           FontSize="13"
                           Foreground="{DynamicResource Gray500Brush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Username -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Username"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Gray700Brush}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="UsernameBox"
                         Height="44"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource InputField}"
                         FontSize="14"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="Password"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Gray700Brush}"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="44"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource InputField}"
                             FontSize="14"/>
            </StackPanel>

            <!-- Error -->
            <TextBlock x:Name="ErrorText"
                       Grid.Row="6"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <!-- Buttons -->
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        Height="44"
                        FontSize="14"
                        Click="Cancel_Click"
                        Style="{StaticResource SecondaryButton}"/>

                <Button Grid.Column="2"
                        Content="Approve"
                        Height="44"
                        FontSize="14"
                        Click="Approve_Click"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>
