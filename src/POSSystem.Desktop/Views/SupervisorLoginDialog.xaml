<Window x:Class="POSSystem.Desktop.Views.SupervisorLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supervisor Access"
        Height="340"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="White"
        ShowInTaskbar="False">

    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="28">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE72E;" 
                               FontFamily="{StaticResource IconFont}" 
                               FontSize="18" 
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Supervisor Approval"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1A1A1A"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="ActionText"
                           Text="Please enter supervisor credentials to continue"
                           FontSize="13"
                           Foreground="#666666"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Username -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Username"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#555555"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="UsernameBox"
                         Height="40"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource InputTextBox}"
                         FontSize="14"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="Password"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#555555"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="40"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource InputPasswordBox}"
                             FontSize="14"/>
            </StackPanel>

            <!-- Error -->
            <TextBlock x:Name="ErrorText"
                       Grid.Row="6"
                       Foreground="#FF5252"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <!-- Buttons -->
            <Grid Grid.Row="8" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        Height="42"
                        FontSize="14"
                        Click="Cancel_Click"
                        Style="{StaticResource SecondaryButton}"/>

                <Button Grid.Column="2"
                        Content="Approve"
                        Height="42"
                        FontSize="14"
                        Click="Approve_Click"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>